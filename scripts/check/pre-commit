#!/bin/sh
# Optional git hook: run the plugin check when lazy-lock.json is being committed.
# Install with:  ln -s ../../scripts/check/pre-commit .git/hooks/pre-commit
# Skip once with: git commit --no-verify
if git diff --cached --name-only | grep -qx 'lazy-lock.json'; then
	exec "$(git rev-parse --show-toplevel)/scripts/check/run"
fi
